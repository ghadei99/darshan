# Copy to .env.local. Never commit real keys.
# Do not prefix provider keys with NEXT_PUBLIC_.

# gemini | openrouter | groq  (default: gemini)
AI_PROVIDER=gemini

# Gemini (used when AI_PROVIDER is unset or gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter (used when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Groq (used when AI_PROVIDER=groq)
GROQ_API_KEY=
# Ordered failover list. First success wins; retryable failures try the next model.
GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,qwen/qwen3.6-27b,openai/gpt-oss-20b,llama-3.1-8b-instant
